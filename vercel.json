{
  "version": 2,
  "builds": [
    { "src": "api/activate.js", "use": "@vercel/node" },
    { "src": "api/admin/create-license.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/activate", "dest": "/api/activate.js" },
    { "src": "/api/v1/activate", "dest": "/api/activate.js" },
    { "src": "/activate.php", "dest": "/api/activate.js" },
    { "src": "/api/admin/create-license", "dest": "/api/admin/create-license.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
